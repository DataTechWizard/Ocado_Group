# ──────────────────────────────────────────────
# Ocado OSP — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Google Cloud / BigQuery ──────────────────
GCP_PROJECT_ID=
GCP_REGION=europe-west2
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# BigQuery dataset for GA4 exports
BQ_DATASET_GA4=
BQ_DATASET_REPORTING=

# ── GA4 / GTM ───────────────────────────────
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GTM_WORKSPACE_ID=

# ── Firebase ─────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# ── Ocado Internal ───────────────────────────
# Add any internal API endpoints or tokens here
# once access is granted.
